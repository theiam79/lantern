{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "spa": {
        "ClusterId": "vite",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "vite": {
        "Destinations": {
          "viteDev": { "Address": "http://localhost:5173/" }
        }
      }
    }
  }
}
